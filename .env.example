# Supabase Configuration (Required)
# Found in your Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: Google Sheets Webhook URL
# Generated from deploying google-apps-script.js as a Web App
GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/your-deployment-id/exec
